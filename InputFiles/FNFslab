type eigenPhysicsPackage;

pop      500;
active   500;
inactive 50;
XSdata   mg;
dataType mg;
outputFormat asciiJSON;
outputFile outputFNF;
doDebug 0;
N_skipFM 20;
N_skipFMActive 20;
combing 1;
preserveWgt 1;

    
fm {type simpleFMClerkExt;
  map {type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 2; } doDebug 1; window 20; forceOne 0; skipCycles 1; printEV 1; isTally 0; }

fmActive {type simpleFMClerkExt;
        map {type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 2; } doDebug 1; window 0; forceOne 0; skipCycles 0; printEV 1; isTally 0; }     

source { type pointSource; r (-15.5 0.0 0.0); particle neutron; G 1; }

collisionOperator { neutronMG {type neutronMGstd;}
                  }

transportOperator { type transportOperatorDT;
                  }

particleBins { type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 40; }

inactiveTally {
                shannon_entropy { type shannonEntropyClerk;
                  map { type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 2;}
                  cycles 500; }
		
	           	 flux { type collisionClerkCycle; response (flux_x); flux_x {type fluxResponse; } 
                  map { type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 40; } cycles 500; }
              }
              

activeTally  {
	             	shannon_entropy { type shannonEntropyClerk;
                  map { type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 2;}
                  cycles 500; }
	             	
	             	flux { type collisionClerkCycle; response (flux_x); flux_x {type fluxResponse; } 
                  map { type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 40; } cycles 500; }

                fmTally {type simpleFMClerkExt;
                  map {type spaceMap; axis x; grid lin; min -16.0; max 16.0; N 2; } doDebug 0; window 0; forceOne 0; skipCycles 10; printEV 0; isTally 1; } 
        }

viz {
     plotFNF { type bmp; axis y; centre (0.0 0.0 0.0); res (200 200); output FNFgeom; }
}

geometry {
    type geometryStd;
    boundary (1 1 2 2 2 2);
    graph {type shrunk;}

    surfaces
    {
      absorbBox { id 1; type box; origin ( 0.0  0.0  0.0); halfwidth (15.0 20.0 20.0); }
      fissileBox { id 2; type box; origin ( 0.0  0.0  0.0); halfwidth (16.0 2.0 2.0); }
    }


    cells
    {
      absorbCell { id 1; type simpleCell; surfaces (-1); filltype mat; material absorbMat; }
      fissileCell { id 2; type unionCell; surfaces [-2 1]; filltype mat; material fissileMat; }
    }

    universes
    {
      slab
      {
          id 2;
          type cellUniverse; cells (1 2); 
          checkOverlap 1;
      }

      root
      {
          id 1;
          type rootUniverse;
          border 2;
          fill u<2>;
      }
    }
}

nuclearData {

  handles {
     mg { type baseMgNeutronDatabase; PN P0;}
  }


materials {

    absorbMat {
      temp       273;
      composition {
      }
      xsFile ./XS/absorb_XSS;
      rgb (200 0 0);
    }
    fissileMat {
      temp       273;
      composition {
      }
      xsFile ./XS/fissile_XSS;
      rgb (0 0 200);
    }

}


}



